# Sisteme de operare
.DS_Store
Thumbs.db

# Editoare
.vscode/
.idea/
*.swp

# Tooling local Claude Code: ignora tot ce e local (setari, loguri, fisiere de referinta)...
.claude/*
# ...dar urmareste skill-urile si scripturile partajate (cu tot ce contin)
!.claude/skills/
!.claude/scripts/

# Backup-uri locale exportate din aplicație
mi-dia-backup-*.json

# Secrete / variabile de mediu (future-proofing pentru versiunea publica)
.env
.env.*

# Note private + scratch de design — pastrate local, NU publice
private/

# Loc de joaca pentru invatat JS (local only — NU face parte din app, NU se deploye-aza)
sandbox/

# Dependențe / build (doar dacă adaugi mai târziu Node/Vite)
node_modules/
dist/
.cache/

# Playwright (harness de test dev-only in e2e/ — vezi CLAUDE.md)
quality/e2e/test-results/
quality/e2e/playwright-report/
quality/e2e/blob-report/
quality/e2e/all-blob-reports/
quality/e2e/theme-grid-out/
quality/e2e/.playwright/
quality/e2e/results.json
quality/e2e/TEST-REPORT.md

# Local scratch: assets and experiments mid-flight. One folder, so the root never collects them again.
scratch/
.wrangler/

# Content skills — local, not part of the public repository.
#
# All six read private/marketing/, which is gitignored, so anyone cloning this repo gets skills that
# cannot run. They also serve a paused initiative, while this repository is about how the app is
# tested and shipped. They stay on disk and stay usable; they just do not belong in the showcase.
# (The same reasoning keeps interview-drill out, via .git/info/exclude.)
.claude/skills/brand-brief/
.claude/skills/content-coach/
.claude/skills/post-writer/
.claude/skills/post-grader/
.claude/skills/viral-hooks/
.claude/skills/repurpose/

# Laboratory and brand skills — local for the same reason.
#
# decizie writes the decision log, experiment runs on private/Prototype and private/Experiments,
# product-review executes a protocol that lives in private/, and marketing-design takes its authority
# from the Constitution, the brand law and the approved mockups. Every one of them is inert without
# the private corpus, so shipping them in a public repository ships something that cannot run.
.claude/skills/decizie/
.claude/skills/experiment/
.claude/skills/product-review/
.claude/skills/marketing-design/
