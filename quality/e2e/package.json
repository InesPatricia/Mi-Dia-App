{
  "name": "mi-dia-app",
  "version": "1.0.0",
  "description": "Mi Dia - Mediterranean daily planner PWA (single-file app; this manifest exists only for the dev-only Playwright test harness).",
  "private": true,
  "scripts": {
    "test": "playwright test --project=mobile-chromium",
    "test:headed": "playwright test --project=mobile-chromium --headed",
    "test:watch": "playwright test --project=mobile-chromium --headed --workers=1",
    "test:ui": "playwright test --ui",
    "test:shard": "playwright test --project=mobile-chromium --shard=1/2",
    "test:generated": "playwright test --project=generated",
    "test:merge": "playwright merge-reports --reporter html ./all-blob-reports",
    "report": "node make-report.js",
    "validate": "node validate-build.js",
    "count": "node count-tests.js",
    "count:check": "node count-tests.js --check",
    "test:report": "playwright show-report",
    "wait:deploy": "node wait-for-deploy.js",
    "smoke:prod": "playwright test --config=playwright.prod.config.js",
    "codegen": "playwright codegen http://localhost:5173"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "http-server": "^14.1.1"
  }
}
