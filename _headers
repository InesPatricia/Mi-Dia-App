# Cloudflare Pages security headers — added after the OWASP ZAP baseline triage
# (2026-07-27). Every decision, including the accepted risks, is documented in
# SECURITY-NOTES.md. Pages applies this file to preview deployments too, so any
# change here is validated on a branch preview URL before it reaches production.

/*
  ! Access-Control-Allow-Origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; manifest-src 'self' data:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
